{
  "steps": [
    {
      "kind": "sidecar",
      "bin": "ffmpeg",
      "args": [
        "-i",
        "{in0}",
        "-c:v",
        "libopenh264",
        "-b:v",
        "39413k",
        "-maxrate",
        "45325k",
        "-bufsize",
        "78826k",
        "-pix_fmt",
        "yuv420p",
        "-c:a",
        "aac",
        "-b:a",
        "128k",
        "-movflags",
        "+faststart",
        "{tmp}/compressed.mp4"
      ],
      "totalUs": 5024000
    }
  ],
  "outputs": [{ "from": "{tmp}/compressed.mp4", "baseName": "video (25MB)", "ext": "mp4" }]
}
