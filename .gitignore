# Node
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Sidecar binaries — never committed; fetched by scripts/fetch-sidecars.ps1
src-tauri/sidecars/*.exe
src-tauri/sidecars/*.dll

# Test fixtures — generated by scripts/make-test-assets.ps1, not committed.
# They are deterministic output of the pinned sidecars; only hand-written
# fixtures (vector.svg) and the golden plan JSON belong in git.
test/assets/*
!test/assets/vector.svg

# Smoke/test scratch output
smoke-out/

# Local machine noise
*.log
.DS_Store
Thumbs.db

# Build artefacts that occasionally land in the tree
*.reg

# Agent scratch. Session worktrees under here are embedded git repos, so
# `git add -A` would commit them as broken submodule stubs.
.claude/
