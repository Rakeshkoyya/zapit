{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline capability for the (hidden) main window and future job windows.",
  "windows": ["main", "progress-*", "options-*", "result-*", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "opener:allow-open-path",
    "cli:default",
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "shell:default"
  ]
}
